# numeric goodreads user id, e.g. the digits in goodreads.com/user/show/91945579-dao-chau
# copy this file to .env (gitignored) for local dev; set as a repo secret for the deploy workflow
GOODREADS_USER_ID=
# optional: goodreads shelf rss key (treat as a secret). when set, it is appended as key=<value> to the feed request
GOODREADS_RSS_KEY=
