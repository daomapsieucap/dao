---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
import { coverAt, fetchShelf, type Book } from "@/utils/goodreads";
import { GOODREADS_USER_ID } from "@/data/config";

const [currentlyReading, favorites, recentlyRead] = await Promise.all([
    fetchShelf("currently-reading", 3),
    fetchShelf("favorites", 24),
    fetchShelf("read", 24),
]);

// merge read + favorites into one list so every favorite always shows up here,
// even if it fell outside the (5 book) recently-read widget
const shelfById = new Map<number, Book & { isFavorite: boolean }>();
for (const book of recentlyRead) shelfById.set(book.id, { ...book, isFavorite: false });
for (const book of favorites) {
    const existing = shelfById.get(book.id);
    if (existing) existing.isFavorite = true;
    else shelfById.set(book.id, { ...book, isFavorite: true });
}
const shelfBooks = [...shelfById.values()];
const hasFavorites = shelfBooks.some((b) => b.isFavorite);

const profileUrl = GOODREADS_USER_ID
    ? `https://www.goodreads.com/user/show/${GOODREADS_USER_ID}`
    : null;
---

<Layout
        title="dao chau · reading"
        description="what's open right now, the rest pulled from the shelf."
>
    <Hero meta="Loc 1 of 60" title="off the clock," em="mostly reading." sub="what's open right now, the rest pulled from the shelf." />

    <Section id="open" meta="Loc 4-8 · currently reading" title="open">
        {currentlyReading.length === 0 ? (
            <p class="empty">nothing open right now. probably between books.</p>
        ) : (
            <div class="cols-2 now-books">
                {currentlyReading.map((book) => (
                    <a class="book book-row" href={book.link} target="_blank" rel="noopener">
                        <span class="cover">
                            <img src={coverAt(book.coverUrl, 180)} srcset={`${coverAt(book.coverUrl, 180)} 1x, ${coverAt(book.coverUrl, 360)} 2x`} alt="" loading="lazy" decoding="async" width="112" height="168" />
                        </span>
                        <span class="book-info">
                            <span class="meta">in progress</span>
                            <span class="book-title">{book.title}</span>
                            <span class="book-author">by {book.author}</span>
                            <span class="book-link">on goodreads ↗</span>
                        </span>
                    </a>
                ))}
            </div>
        )}
    </Section>

    <Section id="shelf" meta="Loc 10-58 · on the shelf" title="shelf">
        {shelfBooks.length === 0 ? (
            <p class="empty">the shelf is empty here. check back after a rebuild.</p>
        ) : (
            <>
                {hasFavorites && (
                    <div class="pills" role="group" aria-label="Filter shelf" hidden>
                        <button class="pill" type="button" aria-pressed="true" data-filter="all">all</button>
                        <button class="pill" type="button" aria-pressed="false" data-filter="fav">favorites</button>
                    </div>
                )}
                <p class="sr-only" id="shelf-status" role="status"></p>
                <div class="shelf-grid" id="shelf-grid">
                    {shelfBooks.map((book) => (
                        <a class="book" href={book.link} target="_blank" rel="noopener" data-fav={book.isFavorite ? "1" : undefined}>
                            <span class="cover">
                                <img src={coverAt(book.coverUrl, 270)} srcset={`${coverAt(book.coverUrl, 270)} 180w, ${coverAt(book.coverUrl, 405)} 270w, ${coverAt(book.coverUrl, 540)} 360w`} sizes="(max-width: 640px) 30vw, 180px" alt="" loading="lazy" decoding="async" width="140" height="210" />
                                {book.isFavorite && <><span class="fav" aria-hidden="true"></span><span class="sr-only">favorite</span></>}
                            </span>
                            <span class="shelf-title">{book.title}</span>
                            <span class="shelf-author">{book.author}</span>
                        </a>
                    ))}
                </div>
            </>
        )}
    </Section>

    <Highlight loc={60}>You become what you feed your mind.</Highlight>

    <Footer>via goodreads{profileUrl && <> · <a href={profileUrl} target="_blank" rel="noopener">full shelf ↗</a></>}</Footer>

    <script is:inline>
        (function () {
            var group = document.querySelector('.pills');
            var grid = document.getElementById('shelf-grid');
            if (!group || !grid) return;
            var pills = group.querySelectorAll('.pill');
            var books = grid.querySelectorAll('.book');
            var status = document.getElementById('shelf-status');
            group.hidden = false;
            pills.forEach(function (pill) {
                pill.addEventListener('click', function () {
                    var favOnly = pill.getAttribute('data-filter') === 'fav';
                    pills.forEach(function (p) { p.setAttribute('aria-pressed', String(p === pill)); });
                    var shown = 0;
                    books.forEach(function (b) {
                        b.hidden = favOnly && !b.hasAttribute('data-fav');
                        if (!b.hidden) shown++;
                    });
                    if (status) status.textContent = 'showing ' + shown + (favOnly ? ' favorite' : '') + ' book' + (shown === 1 ? '' : 's');
                });
            });
        })();
    </script>
</Layout>
