---
import Layout from "@/layouts/Layout.astro";
import projects from "@/data/projects";
import Rail from "@/components/Rail.astro";
import { getCollection } from "astro:content";
import { relativeDate } from "@/utils/relativeDate";

const [latestNow] = (await getCollection("now")).sort(
    (a, b) => b.data.updated.getTime() - a.data.updated.getTime()
);
const nowAge = relativeDate(latestNow.data.updated);
const nowDate = latestNow.data.updated.toISOString().slice(0, 10);
---

<Layout>
    <main class="shell" data-screen-label="home">

        <Rail
            role="backend developer"
            nav={[
            { href: "#desc", n: "01", t: "description" },
            { href: "#projects", n: "02", t: "echo" },
            { href: "#now", n: "03", t: "now" },
            { href: "#notes", n: "04", t: "notes" },
            { href: "/uses", n: "05", t: "uses ↗" },
            { href: "/til", n: "06", t: "til ↗" },
            { href: "/reading", n: "07", t: "reading ↗" },
            ]}
            linkName={false}
        />

        <div class="content" id="content" tabindex="-1">

            <p class="prompt"><span class="c1"><b>dao@chau</b>:~$ <span class="cmd" aria-hidden="true">dao --help</span><span class="cur"
                                                                                          aria-hidden="true"></span></span></p>

            <h1 class="hero">behind the curtain, <em>keeping things running.</em></h1>
            <p class="hero-sub">writes the half of the web you never see.</p>

            <section id="desc" aria-labelledby="s-desc">
                <h2 class="sec" id="s-desc">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>DESCRIPTION</span>
                    <span class="line"></span>
                    <span class="num">01</span>
                </h2>
                <div class="prose">
                    <p>I'm a PHP backend developer who's spent <em>a long while</em> in WordPress. I spend my days in
                        the backend at <em>ViiVue</em>, mostly WordPress work, from corporate sites to WooCommerce, with
                        the occasional Shopify job on the side.</p>
                    <p>off the clock I'm an introvert who reads more than is reasonable. I like fresh air, uncrowded
                        places, and slow days.</p>
                    <div class="v"><i>// </i>a long while means long enough to have opinions about the_content filters.</div>
                </div>
                <div class="chips chips-desc">
                    <span class="chip hl">--php</span>
                    <span class="chip">--wordpress</span>
                    <span class="chip">--woocommerce</span>
                    <span class="chip">--async</span>
                    <span class="chip">--people=few</span>
                    <span class="chip">--reading</span>
                </div>
            </section>

            <section id="projects" aria-labelledby="s-proj">
                <h2 class="sec" id="s-proj">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>ECHO</span>
                    <span class="line"></span>
                    <span class="num">02 · {projects.length} featured</span>
                </h2>
                <div class="projects">
                    {projects.map((project, i) => (
                            <a class="proj" href={project.link} target="_blank" rel="noopener">
                                <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                                <span class="pname">{project.title}</span>
                                <span class="arrow">↗</span>
                                <span class="ptags">
                <span class="ptag" data-tag={project.platform}>{project.platform}</span>
                <span class="ptag role" data-tag={project.role}>{project.role}</span>
                <span class="ptag">{project.type}</span>
              </span>
                            </a>
                    ))}
                </div>
            </section>

            <section id="now" aria-labelledby="s-now">
                <h2 class="sec" id="s-now">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>NOW</span>
                    <span class="line"></span>
                    <span class="num">03 · updated <time datetime={nowDate}>{nowAge.label}</time>{nowAge.days > 60 && (<> <span class="stale"><span class="c" aria-hidden="true">#</span>stale</span></>)} <span class="shelf-link-wrap">· <a href="/now" class="cmd coffee-link">log ↗</a></span></span>
                </h2>
                <dl class="kv">
                    <dt>$ work</dt>
                    <dd>{latestNow.data.work}</dd>
                    <dt>$ learning</dt>
                    <dd>{latestNow.data.learning}</dd>
                    <dt>$ reading</dt>
                    <dd>{latestNow.data.reading} <span class="shelf-link-wrap"><a href="/reading">full shelf ↗</a>.</span></dd>
                </dl>
            </section>

            <section id="notes" aria-labelledby="s-notes">
                <h2 class="sec" id="s-notes">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>NOTES</span>
                    <span class="line"></span>
                    <span class="num">04</span>
                </h2>
                <ul class="notes">
                    <li><b>introvert by wiring</b>I recharge somewhere green and quiet, well away from a crowd.</li>
                    <li><b>bookaholic</b>the unread stack is a feature, not a bug. <span class="v"><i>// </i>the unread stack has its own backlog.</span></li>
                    <li><b>minimalist by taste</b>I'd rather be calm and right than loud and sorry. <span class="v"><i>// </i>this site has a lot of easter eggs for a minimalist. no further questions.</span></li>
                    <li><b>private, not secret</b>I stay dim online, on purpose. not hiding, just low-key. the light's
                        still on, though; email finds me best.
                    </li>
                </ul>
            </section>

            <div class="mantra">
                <p class="mantra-prompt"><span class="c1"><b>dao@chau</b>:~$ <span class="cmd" aria-hidden="true">cat mantra</span></span></p>
                <p class="mantra-out"><span class="mantra-slash" aria-hidden="true">/</span>You become what you feed your mind.<span class="mantra-slash" aria-hidden="true">/</span></p>
            </div>

            <p class="colophon"><span class="c" aria-hidden="true">#</span>this site is small on purpose, much like the rest of my life.
            </p>
<p class="exit"><span class="c1"><b>dao@chau</b>:~$ <span class="cmd" aria-hidden="true">exit 0</span><span class="cur"
                                                                                    aria-hidden="true"></span></span></p>

        </div>
    </main>
</Layout>
