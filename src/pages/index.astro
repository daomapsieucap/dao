---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
import projects from "@/data/projects";
import { getCollection } from "astro:content";

const [latestNow] = (await getCollection("now")).sort(
    (a, b) => b.data.updated.getTime() - a.data.updated.getTime()
);
const nowDate = latestNow.data.updated.toISOString().slice(0, 10);
---

<Layout>
    <Hero
        meta="Loc 1 of 80 · time left in book: 4 min"
        title="backstage,"
        em="keeping things running."
        sub="writes the half of the web you never see."
    />

    <Section id="desc" meta="Loc 8-15" title="description">
        <p class="tags tags-lead">php · wordpress · woocommerce · <ruby>async<rt>not in real time</rt></ruby> · people=few · reading</p>
        <div class="cols-2 prose-lg">
            <p>PHP developer, years among <ruby>WordPress<rt>website builder</rt></ruby> hooks and filters. At <i>ViiVue</i>: company sites, <ruby>WooCommerce<rt>online stores</rt></ruby> stores, and Shopify on request.</p>
            <p>After hours I call <mark>sleep()</mark> on my plans. Peaceful and spacious, open to a good read, closed to deadlines.</p>
        </div>
    </Section>

    <Section id="projects" meta={`Loc 20-48 · ${projects.length} titles`} title="echo">
        <ol class="projects">
            {projects.map((project, i) => (
                <li>
                    <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <span class="proj">
                        <a href={project.link} target="_blank" rel="noopener">{project.title}</a>
                        <span class="proj-tags">{project.platform} · {project.role} · {project.type}</span>
                    </span>
                </li>
            ))}
        </ol>
    </Section>

    <Section id="now" meta={`Loc 50-54 · synced ${nowDate}`} title="now">
        <div class="cols-3 prose-md">
            <div><p class="meta">work</p><p>{latestNow.data.work}</p></div>
            <div><p class="meta">learning</p><p>{latestNow.data.learning}</p></div>
            <div>
                <p class="meta">reading</p>
                <p>{latestNow.data.reading} <a href="/reading">full shelf</a></p>
                <p class="small-link"><a href="/now">older snapshots</a></p>
            </div>
        </div>
    </Section>

    <Section id="notes" meta="Loc 60-66" title="notes">
        <div class="cols-2 notes prose-md">
            <div><p class="note-t">airplane mode</p><p>fresh air, no crowd, zero notifications.</p></div>
            <div><p class="note-t">syncing slowly</p><p>every book leaves <mark>something small</mark> behind.</p></div>
            <div><p class="note-t"><ruby>minimalist<rt>less is more</rt></ruby> by taste</p><p>if it doesn't need to be there, it isn't.</p></div>
            <div><p class="note-t">screensaver on</p><p>still here, just not broadcasting. email wakes me up.</p></div>
        </div>
    </Section>

    <Highlight loc={80}>You become what you feed your mind.</Highlight>

    <Footer>small on purpose, much like the rest of my life.</Footer>
</Layout>
