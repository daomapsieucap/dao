---
import Layout from "@/layouts/Layout.astro";
import LogoMark from "@/components/LogoMark.astro";
import RailFoot from "@/components/RailFoot.astro";
---

<Layout
        title="dao chau · banana not found"
        description="that page isn't here. have a banana instead."
        noindex={true}
>
    <main class="shell" data-screen-label="404">

        <!-- identity rail -->
        <aside class="rail">
            <LogoMark />

            <div class="id-block">
                <h1 class="id-name"><a href="/"><span class="w">dao</span><span class="w">chau</span></a></h1>
                <p class="id-role">banana not found</p>
            </div>

            <div class="rail-divider"></div>

            <nav aria-label="Sections">
                <ul class="nav">
                    <li><a href="/"><span class="n" aria-hidden="true">cd</span><span class="t">~ home</span></a></li>
                    <li><a href="#name"><span class="n" aria-hidden="true">01</span><span class="t">name</span></a></li>
                    <li><a href="#description"><span class="n" aria-hidden="true">02</span><span class="t">description</span></a></li>
                    <li><a href="#exit-status"><span class="n" aria-hidden="true">03</span><span class="t">exit status</span></a></li>
                    <li><a href="#see-also"><span class="n" aria-hidden="true">04</span><span class="t">see also</span></a></li>
                </ul>
            </nav>

            <RailFoot />
        </aside>

        <!-- content column -->
        <div class="content">

            <p class="prompt"><b>dao@chau</b>:~$ <span class="cmd" aria-hidden="true">cd /banana</span><span class="cur"
                                                                                          aria-hidden="true"></span></p>

            <h2 class="hero">404, <em class="ln">banana not found.</em></h2>
            <p class="hero-sub">bash: cd: /banana: No such file or directory</p>

            <!-- NAME -->
            <section id="name" aria-labelledby="s-name">
                <h3 class="sec" id="s-name">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>NAME</span>
                    <span class="line"></span>
                    <span class="num">01</span>
                </h3>
                <p class="sec-note">banana &mdash; the fruit you get instead of the page you asked for.</p>
            </section>

            <!-- DESCRIPTION -->
            <section id="description" aria-labelledby="s-description">
                <h3 class="sec" id="s-description">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>DESCRIPTION</span>
                    <span class="line"></span>
                    <span class="num">02</span>
                </h3>
                <div class="prose">
                    <p>the route you tried does not resolve. <code>banana</code>, on the other hand, resolves quite
                        reliably: fruit in, peel out, no further configuration required.</p>
                    <p>it does not know where your page went. it was never designed to.</p>
                </div>

                <div class="nana">
                    <button class="nana-btn" id="peel" type="button">
                        <svg class="nana-svg" viewBox="0 0 140 116" aria-hidden="true">
                            <rect class="nana-stem" x="32" y="0" width="11" height="16" rx="3"/>
                            <path class="nana-body"
                                  d="M30 14 C30 66 68 100 116 92 C122 91 126 87 125 82 C124 77 119 74.5 113 75.5 C74 82 46 52 44 14 Z"/>
                            <path class="nana-shine" d="M42 24 C46 54 66 76 96 81"/>
                        </svg>
                        <span class="nana-cta">./banana -p</span>
                    </button>

                    <div class="nana-side">
                        <p class="nana-out" id="peel-out" role="status">$ ./banana --peel</p>
                        <p class="nana-count">peels this session: <b id="peel-n">0</b></p>
                    </div>
                </div>
            </section>

            <!-- EXIT STATUS -->
            <section id="exit-status" aria-labelledby="s-exit-status">
                <h3 class="sec" id="s-exit-status">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>EXIT STATUS</span>
                    <span class="line"></span>
                    <span class="num">03</span>
                </h3>
                <dl class="kv">
                    <dt>0</dt>
                    <dd>consumed without incident.</dd>
                    <dt>1</dt>
                    <dd>peel gave more resistance than the manual implies.</dd>
                    <dt>2</dt>
                    <dd>was, on closer inspection, a plantain.</dd>
                    <dt>404</dt>
                    <dd>banana not found. you are, technically, looking at it.</dd>
                </dl>
            </section>

            <!-- SEE ALSO -->
            <section id="see-also" aria-labelledby="s-see-also">
                <h3 class="sec" id="s-see-also">
                    <span class="dot"></span>
                    <span class="lab"><span class="php" aria-hidden="true">&lt;?</span>SEE ALSO</span>
                    <span class="line"></span>
                    <span class="num">04</span>
                </h3>
                <p class="sec-note">paths that do resolve.</p>
                <dl class="kv">
                    <dt>$ cd ~</dt>
                    <dd>the <a href="/">front page</a>. projects, now, notes.</dd>
                    <dt>$ ls /til</dt>
                    <dd><a href="/til">things I learned</a>, one file at a time.</dd>
                    <dt>$ cat /uses</dt>
                    <dd>the <a href="/uses">hardware and software</a> I keep around.</dd>
                    <dt>$ tail /reading</dt>
                    <dd>what's <a href="/reading">open on the desk</a> right now.</dd>
                </dl>
            </section>

            <p class="colophon"><span class="c" aria-hidden="true">#</span>if you followed a link here, it was probably
                mine to break. email finds me.</p>
            <p class="exit"><b>dao@chau</b>:~$ <span class="cmd"><a href="/">cd ~</a></span><span class="cur"
                                                                                                  aria-hidden="true"></span>
            </p>

        </div>
    </main>

    <script is:inline>
        (function () {
            var btn = document.getElementById('peel');
            var out = document.getElementById('peel-out');
            var num = document.getElementById('peel-n');
            if (!btn || !out || !num) return;

            var lines = [
                'layer gone. the page is still missing.',
                'searching /var/bananas ... 0 results.',
                'the goggles help you see, not find.',
                'this is a 404 with extra steps.',
                'still potassium. still not the page you wanted.',
                'fine. go home, the link is right there.'
            ];

            var count = 0;

            btn.addEventListener('click', function () {
                out.textContent = lines[count % lines.length];
                count += 1;
                num.textContent = String(count);
                btn.classList.remove('is-peeling');
                void btn.offsetWidth;
                btn.classList.add('is-peeling');
            });
        })();
    </script>
</Layout>
