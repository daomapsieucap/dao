---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
        title="dao chau · banana not found"
        description="that page isn't here. have a banana instead."
        noindex={true}
>
    <section class="nf" id="nf">
        <p class="meta">&lt;? Loc 404 of 80 ?&gt;</p>
        <h1 class="nf-code">
            <span>4</span><svg class="nf-goggle" viewBox="0 0 132 64" role="img" aria-label="0, drawn as a goggle">
                <defs>
                    <pattern id="bd" width="3" height="3" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.2" fill="currentColor"/></pattern>
                    <pattern id="bl" width="3.4" height="3.4" patternUnits="userSpaceOnUse"><circle cx="1.7" cy="1.7" r=".6" fill="currentColor"/></pattern>
                </defs>
                <rect x="0" y="27" width="30" height="11" rx="3" fill="url(#bl)" stroke="currentColor" stroke-width=".8"/>
                <rect x="102" y="27" width="30" height="11" rx="3" fill="url(#bl)" stroke="currentColor" stroke-width=".8"/>
                <circle cx="66" cy="32" r="29" fill="url(#bd)"/>
                <circle class="mark-paper" cx="66" cy="32" r="24"/>
                <g class="nf-eye">
                    <circle cx="66" cy="32" r="13" fill="none" stroke="currentColor" stroke-width="1.4"/>
                    <circle cx="66" cy="32" r="6" fill="currentColor"/>
                    <circle class="mark-paper" cx="62.5" cy="28.5" r="2.6"/>
                </g>
                <circle class="mark-lid" cx="66" cy="32" r="24" fill="url(#bd)"/>
            </svg><span>4</span>
        </h1>
        <p class="nf-sub">the goggle looked everywhere. no page, just a banana.</p>
    </section>

    <Section id="see-also" meta="Loc 30-40 · paths that do resolve" title="see also">
        <dl class="kv kv-mono">
            <div><dt>cd ~</dt><dd>the <a href="/">front page</a>. projects, now, notes.</dd></div>
            <div><dt>ls /til</dt><dd><a href="/til">things I learned</a>, one file at a time.</dd></div>
            <div><dt>cat /uses</dt><dd>the <a href="/uses">hardware and software</a> I keep around.</dd></div>
            <div><dt>tail /reading</dt><dd>what's <a href="/reading">open on the desk</a> right now.</dd></div>
        </dl>
    </Section>

    <Footer class="foot-mid"><a href="/">back to the front page</a></Footer>

    <script is:inline>
        (function () {
            var area = document.getElementById('nf');
            var eye = document.querySelector('.nf-eye');
            if (!area || !eye || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var clamp = function (v) { return Math.max(-6, Math.min(6, v)); };
            area.addEventListener('pointermove', function (e) {
                if (e.pointerType === 'touch') return;
                var r = area.getBoundingClientRect();
                var x = clamp((e.clientX - r.left - r.width / 2) / r.width * 16);
                var y = clamp((e.clientY - r.top - r.height / 2) / r.height * 14);
                eye.setAttribute('transform', 'translate(' + x.toFixed(2) + ' ' + y.toFixed(2) + ')');
            });
            area.addEventListener('pointerleave', function () { eye.setAttribute('transform', 'translate(0 0)'); });
        })();
    </script>
</Layout>
