---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";

const snapshots = (await getCollection("now")).sort(
    (a, b) => b.data.updated.getTime() - a.data.updated.getTime()
);
const count = `${snapshots.length} ${snapshots.length === 1 ? "snapshot" : "snapshots"}`;
---

<Layout
        title="dao chau · now"
        description="snapshots of the now section, newest first. nothing gets deleted."
>
    <Hero meta={`Loc 1 of 20 · ${count}`} title="what I was doing," em="when I was doing it." sub="snapshots of the now section, newest first. nothing gets deleted." />

    {snapshots.map(({ id, data }, i) => {
        const date = data.updated.toISOString().slice(0, 10);
        return (
            <Section id={`now-${id}`} meta={`Loc ${4 + i * 5}-${8 + i * 5} · synced ${date}`} title={date.slice(0, 7)}>
                <div class="cols-3 prose-md ruled">
                    <div><p class="meta">work</p><p>{data.work}</p></div>
                    <div><p class="meta">learning</p><p>{data.learning}</p></div>
                    <div><p class="meta">reading</p><p>{data.reading}</p></div>
                </div>
            </Section>
        );
    })}

    <Highlight loc={20}>add a file to <code>now.d/</code>, commit, done.</Highlight>

    <Footer><a href="/">back to the front page</a></Footer>
</Layout>
