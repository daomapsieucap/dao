---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("til")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const rendered = await Promise.all(
    entries.map(async (entry, i) => {
        const { Content } = await render(entry);
        return { entry, Content, loc: i + 2 };
    })
);

/* groups rendered entries by year, newest year first */
const years = [...new Set(rendered.map(({ entry }) => entry.data.date.getUTCFullYear()))].map((year) => ({
    year,
    items: rendered.filter(({ entry }) => entry.data.date.getUTCFullYear() === year),
}));

/* returns the anchor id for a TIL entry, so the slug is defined in one place */
function entryAnchor(id: string) {
    return id.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}

function isoDate(d: Date) {
    return d.toISOString().slice(0, 10);
}

const count = `${entries.length} ${entries.length === 1 ? "entry" : "entries"}`;
---

<Layout
        title="dao chau · til"
        description="short notes on things worth keeping. one thing at a time."
>
    <Hero meta={`Loc 1 of ${entries.length} · ${count}`} title="patch notes," em="personal." sub="small updates. no rollback." />

    {years.length === 0 ? (
        <Section title="til"><p class="empty">nothing yet. check back soon.</p></Section>
    ) : years.map(({ year, items }) => (
        <Section title={String(year)}>
            {items.map(({ entry, Content, loc }) => {
                const anchor = entryAnchor(entry.id);
                return (
                    <article class="til-entry" id={anchor}>
                        <div class="til-side">
                            <p class="meta">&lt;? Loc {loc} ?&gt;</p>
                            <p class="til-date"><time datetime={isoDate(entry.data.date)}>{isoDate(entry.data.date)}</time></p>
                        </div>
                        <div class="til-main">
                            <h3 class="til-title">{entry.data.title} <a class="til-permalink" href={`#${anchor}`}>#<span class="sr-only"> link to {entry.data.title}</span></a></h3>
                            <div class="til-body"><Content /></div>
                            {entry.data.tags && entry.data.tags.length > 0 && (
                                <p class="tags" lang="en">{entry.data.tags.join(" · ")}</p>
                            )}
                        </div>
                    </article>
                );
            })}
        </Section>
    ))}

    <Highlight loc={entries.length + 1}>add a .md file, commit, done.</Highlight>

    <Footer><a href="/">back to the front page</a></Footer>
</Layout>
