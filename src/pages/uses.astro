---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
        title="dao chau · uses"
        description="the tools behind the curtain. pinned, not locked"
>
    <Hero meta="Loc 1 of 40" title="dotfiles," em="the personal runtime." sub="everything I actually reach for in a day, written down.">
        <nav class="jump" aria-label="On this page"><span class="top-nav-lab">Jump to</span><a href="#bin">bin</a><a href="#hardware">hardware</a><a href="#env">env</a></nav>
    </Hero>

    <Section id="bin" meta="Loc 4-10 · pinned, not locked" title="bin">
        <dl class="kv">
            <div><dt>ide</dt><dd><b><ruby>PhpStorm.<rt>full X-Ray</rt></ruby></b></dd></div>
            <div><dt>notes</dt><dd><b><ruby>Obsidian.<rt>notes &amp; highlights</rt></ruby></b></dd></div>
            <div><dt>browser</dt><dd><b><ruby>Brave.<rt>new default</rt></ruby></b></dd></div>
            <div><dt>ssh</dt><dd><b>Xermius.</b></dd></div>
            <div><dt>shell</dt><dd><b>PowerShell 7.</b></dd></div>
            <div><dt>ai</dt><dd><b>Claude.</b></dd></div>
        </dl>
    </Section>

    <Section id="hardware" meta="Loc 12-24 · runs until it dies" title="hardware">
        <dl class="kv">
            <div><dt>laptop</dt><dd><b><ruby>Lenovo ThinkPad T14.<rt>the company's, technically</rt></ruby></b></dd></div>
            <div><dt>pc</dt><dd><b><ruby>Dell XPS 8700.<rt>still running</rt></ruby></b></dd></div>
            <div><dt>display</dt><dd><b>Dell U2417H.</b></dd></div>
            <div><dt>keyboard</dt><dd><b><ruby>Logitech K120.<rt>simple, but it works</rt></ruby></b></dd></div>
            <div><dt>mouse</dt><dd><b>Logitech MX Anywhere 3,</b> with a Hyperwork Silentium S01 on quiet duty.</dd></div>
            <div><dt>phone</dt><dd><b>Samsung S24.</b></dd></div>
            <div><dt>tablet</dt><dd><b><ruby>Samsung Tab A9.<rt>breakpoint tester</rt></ruby></b></dd></div>
            <div><dt>ereader</dt><dd><b><ruby>Kindle Paperwhite 4.<rt>where the reading actually happens</rt></ruby></b></dd></div>
            <div><dt>headphone</dt><dd><b><ruby>Sony WH-1000XM4.<rt>noise cancelling on, world off</rt></ruby></b></dd></div>
            <div><dt>earphone</dt><dd><b><ruby>Samsung Galaxy Buds 3 FE.<rt>lazy loaded. very lazy</rt></ruby></b></dd></div>
        </dl>
    </Section>

    <Section id="env" meta="Loc 26-32 · day-to-day runtime config" title="env">
        <dl class="kv">
            <div><dt>music</dt><dd><b><ruby>Spotify.<rt>on repeat</rt></ruby></b></dd></div>
            <div><dt>downtime</dt><dd><b><ruby>Netflix.<rt>random picks</rt></ruby></b></dd></div>
            <div><dt>fuel</dt><dd><ruby><span><b lang="vi">phin sữa đá,</b> or hot cappuccino.</span><rt>random_int(0, 1) decides</rt></ruby></dd></div>
            <div><dt>noise_level</dt><dd><b>low.</b></dd></div>
        </dl>
    </Section>

    <Highlight loc={40}>nothing here is impressive; all of it is mine.</Highlight>

    <Footer><a href="/">back to the front page</a></Footer>
</Layout>
