---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Highlight from "@/components/Highlight.astro";
import Footer from "@/components/Footer.astro";
import hosts from "@/data/hosts";
---

<Layout
        title="dao chau · hosts"
        description="people and places I read. no algorithm involved."
>
    <Hero meta="Loc 1 of 20 · /etc/hosts" title="sites I resolve to," em="on purpose." sub="people and places I read. no algorithm involved." />

    <Section meta="Loc 4-16 · localhost, but for reading" title="hosts">
        {hosts.length === 0 ? (
            <p class="empty"># /etc/hosts is empty. resolving soon.</p>
        ) : (
            <ul class="hosts">
                {hosts.map(({ host, url, note }) => (
                    <li>
                        <span class="hosts-ip">127.0.0.1</span>
                        <a href={url} target="_blank" rel="noopener">{host}</a>
                        <span class="hosts-note"># {note}</span>
                    </li>
                ))}
            </ul>
        )}
    </Section>

    <Highlight loc={20}>127.0.0.1 means: these feel like home.</Highlight>

    <Footer><a href="/">back to the front page</a></Footer>
</Layout>
