---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
        title="dao chau · permission denied"
        description="dao is not in the sudoers file."
        noindex={true}
>
    <Hero meta="Loc 1 of 12 · sudo dao" title="permission denied," em="politely." sub="dao is not in the sudoers file. this incident will be reported." />

    <Section meta="Loc 4-10" title="incident">
        <dl class="cols-4 prose-md ruled incident">
            <div><dt class="meta">reported to</dt><dd>the goggle. it saw.</dd></div>
            <div><dt class="meta">severity</dt><dd>low. it's a portfolio.</dd></div>
            <div><dt class="meta">privileges</dt><dd>read-only. like most of the internet.</dd></div>
            <div><dt class="meta">remedy</dt><dd><a href="mailto:bichdao.chau@gmail.com">ask nicely</a>.</dd></div>
        </dl>
    </Section>

    <Footer class="foot-far"><a href="/">back to the front page</a></Footer>
</Layout>
