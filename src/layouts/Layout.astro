---
import SEOTags from "@/components/seo/SEOTags.astro";
import Header from "@/components/Header.astro";
import type { PageMeta } from "@/utils/types/PageMeta";

export type Props = PageMeta;

const headTags = Astro.props;
const shortcuts: [string[], string][] = [
  [["t"], "toggle theme"],
  [["?"], "this card"],
  [["g", "h"], "go home"],
  [["g", "t"], "go to til"],
  [["g", "u"], "go to uses"],
  [["g", "r"], "go to reading"],
  [["g", "n"], "go to now"],
  [["Esc"], "close a card"],
];
---

<!DOCTYPE html>
<html lang="en">
  <SEOTags {...headTags} />
  <body>
    <a class="skip-link" href="#content">skip to content</a>
    <div class="wrap">
      <Header />
      <main id="content" tabindex="-1">
        <slot />
      </main>
    </div>
    <div class="card" id="sc-pop" role="dialog" aria-label="Keyboard shortcuts" hidden>
      <p class="meta">&lt;? keys · for the keyboard people ?&gt;</p>
      <dl class="card-list">
        {shortcuts.map(([keys, what]) => (
          <>
            <dt>{keys.map((k, i) => <>{i > 0 && " "}<kbd>{k}</kbd></>)}</dt>
            <dd>{what}</dd>
          </>
        ))}
      </dl>
    </div>
    <p class="say" id="say" role="status"></p>
    <script>
      var btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;

      /* reflects the current theme on the toggle button */
      function syncThemeBtn() {
        if (btn) btn.setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'dark'));
      }

      /* switches the theme without animating every color on the page */
      function applyTheme(theme: string) {
        var root = document.documentElement;
        root.classList.add('is-switching');
        root.setAttribute('data-theme', theme);
        syncThemeBtn();
        setTimeout(function () { root.classList.remove('is-switching'); }, 280);
      }

      syncThemeBtn();
      btn?.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
        try { if (localStorage.getItem('theme')) return; } catch (err) {}
        applyTheme(e.matches ? 'dark' : 'light');
      });

      let awayTitle = '';
      document.addEventListener('visibilitychange', function () {
        if ((document as Document & { prerendering?: boolean }).prerendering) return;
        if (document.hidden && !awayTitle) {
          awayTitle = document.title;
          document.title = '[1]+  Stopped    dao chau'; // nbsp, browsers collapse plain spaces
        } else if (!document.hidden && awayTitle) {
          document.title = awayTitle;
          awayTitle = '';
        }
      });

      const card = document.getElementById('sc-pop');
      let cardOpener: HTMLElement | null = null;
      /* opens or closes the shortcuts card */
      function showCard(open: boolean) {
        if (!card) return;
        if (open) cardOpener = document.activeElement as HTMLElement | null;
        card.hidden = !open;
      }
      document.addEventListener('click', function (e) {
        if (card && !card.hidden && !card.contains(e.target as Node)) showCard(false);
      });

      const sayEl = document.getElementById('say');
      const replies = ['bello! tank yu for visiting.', 'bello! me want banana.', 'poopaye? no. bello.'];
      let replyIdx = 0;
      let sayTimer = 0;
      /* shows the next minionese reply for 3s, then clears it */
      function sayBello() {
        const text = replies[replyIdx++ % replies.length];
        if (sayEl) sayEl.textContent = text;
        clearTimeout(sayTimer);
        sayTimer = window.setTimeout(function () { if (sayEl) sayEl.textContent = ''; }, 3000);
        try { console.log('%c' + text, "font-family: 'JetBrains Mono', monospace; font-size: 13px;"); } catch (e) {}
      }

      let goAt = 0;
      let typed = '';
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          const wasOpen = card && !card.hidden;
          showCard(false);
          if (wasOpen && cardOpener) cardOpener.focus();
          return;
        }
        if (e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
        const el = e.target as HTMLElement | null;
        if (el && (el.isContentEditable || el.closest('input, textarea, select'))) return;
        const key = e.key.toLowerCase();
        if (goAt && Date.now() - goAt < 800) {
          const pages: Record<string, string> = { h: '/', t: '/til', u: '/uses', r: '/reading', n: '/now' };
          goAt = 0;
          if (pages[key]) { location.href = pages[key]; return; }
        }
        if (key === 'g') goAt = Date.now();
        else if (key === 't') btn?.click();
        else if (e.key === '?') showCard(true);
        if (/^[a-z]$/.test(key)) {
          typed = (typed + key).slice(-5);
          if (typed === 'bello') { typed = ''; sayBello(); }
        }
      });

      const logo = document.querySelector<SVGElement>('.mark');
      if (logo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.addEventListener('pointermove', function (e) {
          if (e.pointerType === 'touch') return;
          const r = logo.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const d = Math.hypot(dx, dy) || 1;
          const k = Math.min(5, d / 40);
          logo.style.setProperty('--ex', (dx / d * k).toFixed(2) + 'px');
          logo.style.setProperty('--ey', (dy / d * k).toFixed(2) + 'px');
        }, { passive: true });
      }

      if (logo) {
        let clickTimes: number[] = [];
        let dizzy = false;
        logo.addEventListener('click', function () {
          const now = Date.now();
          clickTimes = clickTimes.filter(function (t) { return now - t < 2000; });
          clickTimes.push(now);
          if (clickTimes.length < 5 || dizzy) return;
          clickTimes = [];
          dizzy = true;
          logo.classList.add('is-dizzy');
          setTimeout(function () { logo.classList.remove('is-dizzy'); dizzy = false; }, 1200);
        });
      }
    </script>
    <script is:inline>
      (function () {
        try {
          console.log(
            "%c◉ dao chau: built by hand, blinking since 2026.",
            "font-family: 'JetBrains Mono', monospace; font-size: 13px;"
          );
          console.log("dig around: https://github.com/daomapsieucap/dao");
        } catch (e) {}
      })();
    </script>
  </body>
</html>
