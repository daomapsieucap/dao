---
import LogoMark from "@/components/LogoMark.astro";
import RailFoot from "@/components/RailFoot.astro";
import hosts from "@/data/hosts";

interface Props {
    role: string;
    nav: { href: string; n: string; t: string }[];
    linkName?: boolean;
}

const { role, nav, linkName = true } = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const siblings = [
    { href: "/now", t: "now" },
    { href: "/uses", t: "uses" },
    { href: "/til", t: "til" },
    { href: "/reading", t: "reading" },
    ...(hosts.length > 0 ? [{ href: "/etc/hosts", t: "hosts" }] : []),
];
const listed = new Set(nav.map((i) => i.href));
const extra = siblings
    .filter((s) => current !== "/" && s.href !== current && !listed.has(s.href))
    .map((s, i) => ({ href: s.href, n: String(nav.length + i).padStart(2, "0"), t: `${s.t} ↗` }));
const all = [...nav, ...extra];

/* tells the in-page anchors apart from the other pages; the group labels only show when both kinds exist */
const anchors = all.filter((i) => i.href.startsWith("#"));
const pages = all.filter((i) => !i.href.startsWith("#") && i.href !== "/");
const home = all.filter((i) => i.href === "/");
const grouped = anchors.length > 0 && pages.length > 0;
const groups = [
    { label: "", items: home },
    { label: grouped ? "on this page" : "", items: anchors },
    { label: pages.length > 0 ? "elsewhere" : "", items: pages },
].filter((g) => g.items.length > 0);
---

<aside class="rail">
    <LogoMark />

    <div class="id-block">
        <p class="id-name">
            {linkName ? (
                <a href="/"><span class="w">dao</span><span class="w">chau</span></a>
            ) : (
                <><span class="w">dao</span><span class="w">chau</span></>
            )}
        </p>
        <p class="id-role">{role}</p>
    </div>

    <div class="rail-divider"></div>

    <nav aria-label="Sections">
        <ul class="nav">
            {groups.map((g) => (
                <>
                    {g.label && <li class="nav-label" aria-hidden="true">{g.label}</li>}
                    {g.items.map(({ href, n, t }) => (
                        <li><a href={href}><span class="n" aria-hidden="true">{n}</span><span class="t">{t}</span></a></li>
                    ))}
                </>
            ))}
        </ul>
    </nav>

    <RailFoot />
</aside>
