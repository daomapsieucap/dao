        </p>
    </div>
    <div class="rf-sec">
        <p class="tm-pr" aria-hidden="true">dao@chau:~$ <span class="tm-cmd">status</span></p>
        <dl class="status-list">
            <div><dt>loc</dt><dd>saigon</dd></div>
            <div><dt>time</dt><dd id="clock">--:--</dd></div>
            <div><dt>mood</dt><dd class="mood" id="mood">idle, mostly</dd></div>
            <div><dt>fuel</dt><dd><a href="https://buymeacoffee.com/daomapsieucap" target="_blank" rel="noopener" class="cmd coffee-link">cà phê sữa đá</a></dd></div>
        </dl>
    </div>
</div>

<script is:inline>
    (function () {
        var clock = document.getElementById("clock");
        var mood = document.getElementById("mood");
        var moodLines = {
            morning: ["cà phê first, backend second", "slow boot: coffee, a chapter, then work"],
            afternoon: ["heads down, backend humming", "keeping things running"],
            evening: ["off the clock: pads, pages, side projects", "logged off. still compiling something."],
            night: ["asleep, probably", "screen off. back by sunrise."],
            weekend: ["idle, mostly", "weekend mode: no deploys", "idle. book open, phone face down."],
        };
        var clockFmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Ho_Chi_Minh", timeZoneName: "short" });
        var moodFmt = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Ho_Chi_Minh", hourCycle: "h23", hour: "numeric", weekday: "short", year: "numeric", month: "numeric", day: "numeric" });

        /* shows the Saigon time */
        function tick() {
            if (clock) clock.textContent = clockFmt.format(new Date()).replace(",", "");
        }

        /* picks a line for the current Saigon day part, stable for the day */
        function updateMood() {
            if (!mood) return;
            var parts = {};
            moodFmt.formatToParts(new Date()).forEach(function (p) { parts[p.type] = p.value; });
            var hour = Number(parts.hour);
            var weekend = parts.weekday === "Sat" || parts.weekday === "Sun";
            var day = Math.floor(Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day)) / 86400000);
            var part = hour >= 23 || hour < 5 ? "night" : hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening";
            var lines = moodLines[part === "night" || !weekend ? part : "weekend"];
            mood.textContent = lines[day % lines.length];
        }

        tick();
        updateMood();
        setInterval(tick, 30000);
        setInterval(updateMood, 600000);
    })();
</script>
