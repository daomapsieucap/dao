            <li><a href="https://github.com/daomapsieucap" data-addr="github.com/daomapsieucap" target="_blank" rel="noopener"><span class="tm-fl"><span aria-hidden="true">--</span>github</span><span class="tm-url">github.com/<wbr>daomapsieucap</span><span class="tm-go" aria-hidden="true">&nearr;</span></a></li>
            <li><a href="https://www.linkedin.com/in/dao-chau" data-addr="linkedin.com/in/dao-chau" target="_blank" rel="noopener"><span class="tm-fl"><span aria-hidden="true">--</span>linkedin</span><span class="tm-url">linkedin.com/<wbr>in/dao-chau</span><span class="tm-go" aria-hidden="true">&nearr;</span></a></li>
