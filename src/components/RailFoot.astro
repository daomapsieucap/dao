    <div class="rf-sec">
        <p class="tm-pr" aria-hidden="true">dao@chau:~$ <span class="tm-cmd">open</span></p>
        <p class="tm-flags">
            <a href="mailto:bichdao.chau@gmail.com" title="bichdao.chau@gmail.com"><span aria-hidden="true">--</span>mail</a>
            <a href="https://github.com/daomapsieucap" target="_blank" rel="noopener" title="github.com/daomapsieucap"><span aria-hidden="true">--</span>github</a>
            <a href="https://www.linkedin.com/in/dao-chau" target="_blank" rel="noopener" title="linkedin.com/in/dao-chau"><span aria-hidden="true">--</span>linkedin</a>
            <a href="https://buymeacoffee.com/daomapsieucap" target="_blank" rel="noopener" title="buymeacoffee.com/daomapsieucap"><span aria-hidden="true">--</span>coffee</a>
        </p>
    </div>
    <div class="rf-sec">
        <p class="tm-pr" aria-hidden="true">dao@chau:~$ <span class="tm-cmd">status</span></p>
        <dl class="status-list">
            <div><dt>loc</dt><dd>saigon</dd></div>
            <div><dt>time</dt><dd id="clock">--:--</dd></div>
            <div><dt>mood</dt><dd class="mood" id="mood">idle, mostly</dd></div>
            <div><dt>fuel</dt><dd><a href="https://buymeacoffee.com/daomapsieucap" target="_blank" rel="noopener" class="cmd coffee-link">cà phê sữa đá</a></dd></div>
        </dl>
    </div>
</div>

<script>
    /* shows the Saigon time and refreshes it every 30 seconds */
    const clock = document.getElementById("clock");
    function tick() {
        if (!clock) return;
        clock.textContent = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Ho_Chi_Minh", timeZoneName: "short" }).format(new Date()).replace(",", "");
    }
    tick();
    setInterval(tick, 30000);
</script>
