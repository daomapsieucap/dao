---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";
import type { PageMeta } from "@/utils/types/PageMeta";
import literataNormalLatin from "@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url";
import literataItalicLatin from "@fontsource-variable/literata/files/literata-latin-wght-italic.woff2?url";
import interNormalLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@fontsource-variable/literata/wght.css";
import "@fontsource-variable/literata/wght-italic.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/main.css";

type Props = PageMeta;

const HANDLE = "@daomapsieucap";
const FALLBACK = {
  title: "dao chau · backend",
  description: "writes the half of the web you never see. behind the curtain, keeping things running.",
  imageAlt: "dao chau's website",
};

const props = Astro.props;
const meta = {
  title: props.title ?? FALLBACK.title,
  description: props.description ?? FALLBACK.description,
  imageAlt: props.imageAlt ?? FALLBACK.imageAlt,
  image: new URL(props.image ?? "/opengraph-image.jpg", SITE_URL).href,
  url: new URL(Astro.url.pathname, SITE_URL).href,
};

// The font-face rules and main.css are inlined into each page (inlineStylesheets in astro.config.mjs),
// so nothing blocks render and the preloaded fonts are usable at first paint.
---

<head>
  <meta charset="UTF-8" />
  <link rel="preload" as="font" type="font/woff2" href={literataNormalLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={literataItalicLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={interNormalLatin} crossorigin />
  <SEO
    title={meta.title}
    description={meta.description}
    noindex={props.noindex ?? false}
    openGraph={{
      basic: { title: meta.title, type: "website", image: meta.image, url: meta.url },
      optional: { description: meta.description },
      image: { alt: meta.imageAlt },
    }}
    twitter={{ creator: HANDLE }}
    extend={{
      link: [
        { rel: "icon", href: "/favicon.svg" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        { rel: "author", href: "/humans.txt" },
      ],
      meta: [
        { name: "viewport", content: "width=device-width, initial-scale=1" },
        { name: "theme-color", content: "#e9e8e3", media: "(prefers-color-scheme: light)" },
        { name: "theme-color", content: "#131313", media: "(prefers-color-scheme: dark)" },
        { name: "generator", content: Astro.generator },
        { name: "twitter:card", content: "summary_large_image" },
        { name: "twitter:site", content: HANDLE },
        { name: "twitter:title", content: meta.title },
        { name: "twitter:description", content: meta.description },
        { name: "twitter:image", content: meta.image },
      ],
    }}
  />
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'granted',
  });
  gtag('js', new Date());
  gtag('config', 'G-SDQ2PWY76X');
  addEventListener('load', function () {
    var load = function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-SDQ2PWY76X';
      document.head.appendChild(s);
    };
    'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1000);
  });
  </script>
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prerender: [{
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/*\\?*" } },
          { not: { selector_matches: "[href^='#'], [target=_blank]" } },
        ],
      },
      eagerness: "moderate",
    }],
  })} />
  <noscript><style>.theme-btn { display: none; }</style></noscript>
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
