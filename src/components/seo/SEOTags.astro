---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";
import type { PageMeta } from "@/utils/types/PageMeta";
import newsreaderNormalLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import newsreaderItalicLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url";
import newsreaderVietnamese from "@fontsource-variable/newsreader/files/newsreader-vietnamese-wght-normal.woff2?url";
import jetbrainsMonoVietnamese from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-vietnamese-wght-normal.woff2?url";
import mainCssHref from "@/styles/main.css?url";
import jetbrainsMonoCssHref from "@fontsource-variable/jetbrains-mono?url";
import newsreaderWghtCssHref from "@fontsource-variable/newsreader/wght.css?url";
import newsreaderWghtItalicCssHref from "@fontsource-variable/newsreader/wght-italic.css?url";

type Props = PageMeta;

const HANDLE = "@daomapsieucap";
const FALLBACK = {
  title: "dao chau · backend",
  description: "writes the half of the web you never see. behind the curtain, keeping things running.",
  imageAlt: "dao chau's website",
};

const props = Astro.props;
const meta = {
  title: props.title ?? FALLBACK.title,
  description: props.description ?? FALLBACK.description,
  imageAlt: props.imageAlt ?? FALLBACK.imageAlt,
  image: new URL(props.image ?? "/opengraph-image.jpg", SITE_URL).href,
  url: new URL(Astro.url.pathname, SITE_URL).href,
};

// Font-only bundles are safe to defer via the media="print" swap below:
// they don't affect layout, so a late swap is invisible. main.css controls
// actual element sizing (e.g. the unsized inline SVG logo), so it stays a
// normal blocking stylesheet to avoid a flash of oversized/unstyled content.
const deferredStylesheets = [
  jetbrainsMonoCssHref,
  newsreaderWghtCssHref,
  newsreaderWghtItalicCssHref,
];
---

<head>
  <link rel="preload" as="font" type="font/woff2" href={newsreaderNormalLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={newsreaderItalicLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={newsreaderVietnamese} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoVietnamese} crossorigin />
  {deferredStylesheets.map((href) => (
    <>
      <link rel="preload" href={href} as="style" />
      <link rel="stylesheet" href={href} media="print" onload="this.media='all'" />
      <noscript><link rel="stylesheet" href={href} /></noscript>
    </>
  ))}
  <link rel="stylesheet" href={mainCssHref} />
  <SEO
    charset="UTF-8"
    title={meta.title}
    description={meta.description}
    noindex={props.noindex ?? false}
    openGraph={{
      basic: { title: meta.title, type: "website", image: meta.image, url: meta.url },
      optional: { description: meta.description },
      image: { alt: meta.imageAlt },
    }}
    twitter={{ creator: HANDLE }}
    extend={{
      link: [
        { rel: "icon", href: "/favicon.svg" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        { rel: "author", href: "/humans.txt" },
      ],
      meta: [
        { name: "viewport", content: "width=device-width, initial-scale=1" },
        { name: "theme-color", content: "#f7f8fa", media: "(prefers-color-scheme: light)" },
        { name: "theme-color", content: "#0d1421", media: "(prefers-color-scheme: dark)" },
        { name: "generator", content: Astro.generator },
        { name: "twitter:card", content: "summary_large_image" },
        { name: "twitter:site", content: HANDLE },
        { name: "twitter:title", content: meta.title },
        { name: "twitter:description", content: meta.description },
        { name: "twitter:image", content: meta.image },
      ],
    }}
  />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SDQ2PWY76X"></script>
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'granted',
  });
  gtag('js', new Date());
  gtag('config', 'G-SDQ2PWY76X');
  </script>
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prerender: [{
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/*\\?*" } },
          { not: { selector_matches: "[href^='#'], [target=_blank]" } },
        ],
      },
      eagerness: "moderate",
    }],
  })} />
  <noscript><style>.theme-btn { display: none; }</style></noscript>
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
