---
import { SITE_URL } from "@/data/config";
import type { PageMeta } from "@/utils/types/PageMeta";
import literataNormalLatin from "@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url";
import literataItalicLatin from "@fontsource-variable/literata/files/literata-latin-wght-italic.woff2?url";
import literataVietnamese from "@fontsource-variable/literata/files/literata-vietnamese-wght-normal.woff2?url";
import interNormalLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/main.css";

type Props = PageMeta;

const HANDLE = "@daomapsieucap";
const FALLBACK = {
  title: "dao chau · backend",
  description: "writes the half of the web you never see. backstage, keeping things running.",
  imageAlt: "dao chau's website",
};

const props = Astro.props;
const meta = {
  title: props.title ?? FALLBACK.title,
  description: props.description ?? FALLBACK.description,
  imageAlt: props.imageAlt ?? FALLBACK.imageAlt,
  image: new URL(props.image ?? "/opengraph-image.jpg", SITE_URL).href,
  url: new URL(Astro.url.pathname, SITE_URL).href,
};

// main.css (with the Literata and Inter font-face rules) is inlined into each page via inlineStylesheets
// in astro.config.mjs, so nothing blocks render and the preloaded fonts are usable at first paint.
---

<head>
  <meta charset="UTF-8" />
  <link rel="preload" as="font" type="font/woff2" href={literataNormalLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={literataItalicLatin} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={literataVietnamese} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={interNormalLatin} crossorigin />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  <meta name="robots" content={props.noindex ? "noindex, follow" : "index, follow"} />
  <link rel="canonical" href={meta.url} />
  <meta name="theme-color" content="#e9e8e3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="author" href="/humans.txt" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={meta.url} />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:image" content={meta.image} />
  <meta property="og:image:alt" content={meta.imageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={HANDLE} />
  <meta name="twitter:creator" content={HANDLE} />
  <meta name="twitter:title" content={meta.title} />
  <meta name="twitter:description" content={meta.description} />
  <meta name="twitter:image" content={meta.image} />
  <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'granted',
  });
  gtag('js', new Date());
  gtag('config', 'G-SDQ2PWY76X');
  addEventListener('load', function () {
    var load = function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-SDQ2PWY76X';
      document.head.appendChild(s);
    };
    'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1000);
  });
  </script>
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prerender: [{
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/*\\?*" } },
          { not: { selector_matches: "[href^='#'], [target=_blank]" } },
        ],
      },
      eagerness: "moderate",
    }],
  })} />
  <noscript><style>.theme-btn { display: none; }</style></noscript>
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
